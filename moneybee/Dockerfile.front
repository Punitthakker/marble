# MoneyBee Compliance - branded Marble frontend (prebuilt bundle)
# The server bundle in moneybee/dist/app is built from the official marble-frontend at
# FRONT_VERSION with moneybee/rebrand.py applied (see moneybee/build-front.sh). This image only
# installs runtime dependencies, so it builds on small builders. For a full source build use
# Dockerfile.front.source.

ARG BUN_IMAGE=oven/bun:1.3.10
ARG RUNTIME_IMAGE=oven/bun:1.3.10-distroless

FROM ${BUN_IMAGE} AS deps
ARG FRONT_VERSION=v1.11.0
WORKDIR /src
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${FRONT_VERSION} https://github.com/checkmarble/marble-frontend.git .
RUN bun install --production --frozen-lockfile \
    && rm -rf node_modules/.bun node_modules/.bin node_modules/@esbuild

FROM ${RUNTIME_IMAGE} AS runtime
ARG FRONT_VERSION=v1.11.0
WORKDIR /prod/app-builder
# Matches upstream marble-frontend runtime image
ENV NODE_ENV=development
ENV PORT=8080
ENV APP_VERSION=${FRONT_VERSION}
ENV SEGMENT_WRITE_KEY=""
COPY --from=deps /src/LICENSE ./LICENSE
COPY --from=deps /src/node_modules ./node_modules
COPY moneybee/dist/app/.output ./.output
EXPOSE 8080
CMD [".output/server/index.mjs"]

# MoneyBee Compliance - branded Marble frontend
# Builds the official checkmarble/marble-frontend at a pinned tag, then applies the MoneyBee
# rebrand layer (moneybee/rebrand.py). Upgrade Marble by bumping FRONT_VERSION to match the
# backend image tag in docker-compose.yaml.
#
# Build context: repository root. Railway: RAILWAY_DOCKERFILE_PATH=moneybee/Dockerfile.front

ARG BUN_IMAGE=oven/bun:1.3.10
ARG RUNTIME_IMAGE=oven/bun:1.3.10-distroless

FROM ${BUN_IMAGE} AS build
ARG FRONT_VERSION=v1.11.0
WORKDIR /src
RUN apt-get update \
    && apt-get install -y --no-install-recommends git python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${FRONT_VERSION} https://github.com/checkmarble/marble-frontend.git .
COPY moneybee/rebrand.py /moneybee/rebrand.py
COPY moneybee/brand /moneybee/brand
RUN python3 /moneybee/rebrand.py /src
RUN bun install --frozen-lockfile
# Heap cap keeps the server bundling step inside an 8 GB builder
RUN cd packages/app-builder && NODE_OPTIONS=--max-old-space-size=5000 VITE_CJS_IGNORE_WARNING=1 bun run build

FROM ${BUN_IMAGE} AS deps-prod
WORKDIR /usr/src/app
COPY --from=build /src/package.json /src/bun.lock ./
COPY --from=build /src/scripts ./scripts
COPY --from=build /src/packages ./packages
RUN bun install --production --frozen-lockfile \
    && rm -rf node_modules/.bun node_modules/.bin node_modules/@esbuild

FROM ${RUNTIME_IMAGE} AS runtime
WORKDIR /prod/app-builder
ARG FRONT_VERSION=v1.11.0
# Matches upstream marble-frontend runtime image
ENV NODE_ENV=development
ENV PORT=8080
ENV APP_VERSION=${FRONT_VERSION}
ENV SEGMENT_WRITE_KEY=""
COPY --from=build /src/LICENSE ./LICENSE
COPY --from=build /src/packages/app-builder/.output ./.output
COPY --from=deps-prod /usr/src/app/node_modules ./node_modules
EXPOSE 8080
CMD [".output/server/index.mjs"]
